# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:54321/gh_automation

# GitHub
GH_TOKEN=ghp_xxxxxxxxxxxxx

# Collector
# Cron schedule (supports seconds as first field for 6-field format)
# Examples: "*/5 * * * *" (every 5 min), "*/10 * * * * *" (every 10 sec)
COLLECTOR_SCHEDULE=*/10 * * * * *
GH_NOTIFY_LIMIT=100

# Outbox Processor
PROCESSOR_INTERVAL_MS=1000
BATCH_SIZE=100

# Logging
LOG_LEVEL=info
